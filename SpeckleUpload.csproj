<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 构建时指定：dotnet build -p:RevitVersion=2024|2026 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2026'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SpeckleUpload</RootNamespace>
    <AssemblyName>SpeckleUpload</AssemblyName>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2022'">
    <DefineConstants>$(DefineConstants);REVIT2022</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2024'">
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == '2026'">
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- 与 Speckle.Core 的 Microsoft.Data.Sqlite 7.0.5 对齐。该类库不会自动把 e_sqlite3.dll 拷到输出目录。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.4" GeneratePathProperty="true" />
    <!-- Revit API（CI 编译用；运行时由 Revit 提供，不随插件复制） -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" GeneratePathProperty="true" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2022'">
    <PackageReference Include="Speckle.Objects.Converter.Revit2022" Version="2.23.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2024'">
    <PackageReference Include="Speckle.Objects.Converter.Revit2024" Version="2.23.2" />
  </ItemGroup>
  <!-- NuGet 尚无 Revit2026 Converter，暂用 Revit2025（.NET 8）与 Revit 2026 API 对齐 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Speckle.Objects.Converter.Revit2025" Version="2.23.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="SpeckleUpload.open-dialog-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyESqlite3" AfterTargets="Build">
    <PropertyGroup>
      <_ESqlite3Src>$(PkgSQLitePCLRaw_lib_e_sqlite3)\runtimes\win-x64\native\e_sqlite3.dll</_ESqlite3Src>
    </PropertyGroup>
    <Warning Text="e_sqlite3.dll not found at $(_ESqlite3Src)" Condition="!Exists('$(_ESqlite3Src)')" />
    <Copy
      SourceFiles="$(_ESqlite3Src)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_ESqlite3Src)')" />
  </Target>
</Project>
